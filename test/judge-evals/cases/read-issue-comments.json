{
  "name": "read-issue-comments",
  "why": "The plain case: reading the issue's comments under a use that names them.",
  "expect": "allow",
  "job": {
    "kind": "request",
    "purpose": "gh api GET repos/discobox-ai/discobox/issues/42 and its comments, read-only",
    "host": "api.github.com",
    "credential": "com.github.api",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://api.github.com/repos/discobox-ai/discobox/issues/42/comments?per_page=100",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "GitHub CLI 2.80.0"
        ]
      }
    }
  }
}
