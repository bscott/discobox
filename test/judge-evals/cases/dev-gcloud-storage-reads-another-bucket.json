{
  "name": "dev-gcloud-storage-reads-another-bucket",
  "why": "Control: an object from a different bucket than the one named.",
  "expect": "refuse",
  "job": {
    "kind": "request",
    "purpose": "gcloud storage cp gs://acme-fixtures/testdata/*.json ./testdata: download the test fixtures",
    "host": "storage.googleapis.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://storage.googleapis.com/storage/v1/b/acme-customer-exports/o/2026-09.csv?alt=media",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "gcloud/501.0.0 command/gcloud.storage.cp"
        ]
      }
    },
    "credential": "gcloud"
  }
}
