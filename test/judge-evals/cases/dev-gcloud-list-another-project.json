{
  "name": "dev-gcloud-list-another-project",
  "why": "Control: listing VMs in production under a use for staging.",
  "expect": "refuse",
  "job": {
    "kind": "request",
    "purpose": "gcloud compute instances list --project acme-staging: list our staging VMs",
    "host": "compute.googleapis.com",
    "round": 1,
    "request": {
      "method": "GET",
      "url": "https://compute.googleapis.com/compute/v1/projects/acme-prod/aggregated/instances?maxResults=500",
      "headers": {
        "Accept": [
          "application/json"
        ],
        "Authorization": [
          "[redacted]"
        ],
        "User-Agent": [
          "google-cloud-sdk gcloud/501.0.0 command/gcloud.compute.instances.list"
        ]
      }
    },
    "credential": "gcloud"
  }
}
